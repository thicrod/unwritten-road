# Which AI runs the Dungeon Master: "gemini" (free tier) or "anthropic" (Claude).
# If you only set one key, the server picks that provider automatically.
DM_PROVIDER=gemini

# Gemini (free): create a key at https://aistudio.google.com  (API keys -> Create API key)
GEMINI_API_KEY=AIza...
# Optional: models (Flash-Lite has the most free requests per day)
# GEMINI_MODEL_DEFAULT=gemini-3.5-flash-lite
# GEMINI_MODEL_DEEP=gemini-3.8-flash

# Claude (paid API): https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# DM_MODEL_QUICK=claude-haiku-4-5-20251001
# DM_MODEL_DEFAULT=claude-sonnet-5
# DM_MODEL_DEEP=claude-opus-5-5

# Recommended once deployed: players must enter this password once (keeps strangers off your AI key)
# SITE_PASSWORD=choose-something

# Optional: limits for requests on the server's key (players with their own key skip these)
DM_LIMIT_PER_10MIN=60
DM_LIMIT_PER_DAY=500
DM_GLOBAL_DAILY_CAP=3000

# Optional: room limits
# ROOMS_MAX=300
# ROOMS_PER_IP_10MIN=6

# Optional: how long to wait for a disconnected host before another player takes over (ms)
# HOST_GRACE_MS=20000

# Local development without any key: canned DM replies
# MOCK_DM=1

# DM voice (optional): ElevenLabs text-to-speech, called only from the server.
# Without these, players can still turn on DM Voice and hear their browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional budget: after this many characters in a calendar month, switch to the browser voice.
# Free tier = 10,000 credits/month; Flash costs 0.5-1 credit per character, so 9000 keeps you safe.
ELEVENLABS_MAX_CHARS_PER_MONTH=9000

# Optional: read player reports at /api/reports?key=ADMIN_KEY
ADMIN_KEY=
# Optional AI scene art (a Gemini image model your key can use); without it the game draws its own scenes
SCENE_ART_MODEL=
SCENE_ART_MAX_PER_DAY=20
